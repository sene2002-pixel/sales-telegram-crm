# Local mode: embedded PostgreSQL (PGlite), persistent data/ directory.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
DATABASE_URL=
DATA_DIR=./data
# Generate with: openssl rand -hex 32. Required in production.
SESSION_SECRET=
# Explicitly enabled local-only demo login. Never allowed in production.
DEV_AUTH=true
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Your numeric Telegram user ID. First login creates the administrator.
BOOTSTRAP_ADMIN_TELEGRAM_ID=
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EXTRACTION_MODEL=gpt-4o-mini
WORKER_ENABLED=true
REPORT_TIMEZONE=Europe/Moscow
MAX_VOICE_SECONDS=600
MAX_VOICE_BYTES=20000000
