# Local mode: embedded PostgreSQL (PGlite), persistent data/ directory.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
DATABASE_URL=
# Docker Compose only: generate separately with openssl rand -hex 32.
POSTGRES_PASSWORD=
DATA_DIR=./data
# Optional shared limits for stored uploads and generated PDFs. Confirm limits before enabling.
FILE_QUOTAS_ENABLED=false
FILE_QUOTA_WARNING_PERCENT=80
FILE_USER_MAX_FILES=5000
FILE_USER_MAX_BYTES=2147483648
FILE_COMPANY_MAX_FILES=1000
FILE_COMPANY_MAX_BYTES=536870912
FILE_SYSTEM_MAX_FILES=100000
FILE_SYSTEM_MAX_BYTES=68719476736
FILE_MIN_FREE_BYTES=536870912
# Generate with: openssl rand -hex 32. Required in production.
SESSION_SECRET=
# Explicitly enabled local-only demo login. Never allowed in production.
DEV_AUTH=true
# Swagger requires an active admin session when enabled.
API_DOCS_ENABLED=false
BOT_TOKEN=
TELEGRAM_API_ENVIRONMENT=production
TELEGRAM_WEBHOOK_SECRET=
# To enable Stars configure the support account, approved terms URL and webhook.
PICO_STARS_ENABLED=false
PICO_STARS_SUPPORT_USERNAME=
PICO_STARS_TERMS_URL=
# Your numeric Telegram user ID. First login creates the administrator.
BOOTSTRAP_ADMIN_TELEGRAM_ID=
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-transcribe
EXTRACTION_MODEL=gpt-6-luna
LETTER_MODEL=gpt-6-luna
WORKER_ENABLED=true
# Per-minute API limits; authentication remains limited to 30 requests per IP.
API_RATE_LIMIT_PER_USER=3000
API_RATE_LIMIT_PER_IP=6000
WORKER_CONCURRENCY=3
# Original requests, clarifications and execution history. CRM records/PDFs are not purged.
REQUEST_RETENTION_DAYS=30
# Temporary DB-only tracing. Empty = off. Use an ISO timestamp with timezone.
# Automatically stops writing at this time; retained logs expire after 3 months.
DIAGNOSTIC_LOG_UNTIL=
REPORT_TIMEZONE=Europe/Moscow
MAX_VOICE_SECONDS=600
MAX_VOICE_BYTES=20000000

# Optional Saby registry enrichment. Leave empty to import without external registry requests.
SABY_ACCESS_TOKEN=
SABY_CLIENT_ID=
SABY_CLIENT_SECRET=
SABY_SERVICE_KEY=

# Enable after choosing budgets for this installation. Shared across PostgreSQL replicas.
AI_USAGE_METRICS_ENABLED=false
AI_BUDGET_ENABLED=false
AI_USER_CONCURRENT=1
AI_SYSTEM_CONCURRENT=6
AI_USER_CALLS_PER_MINUTE=10
AI_USER_CALLS_PER_DAY=100
AI_SYSTEM_CALLS_PER_DAY=1000
AI_MAX_OUTPUT_TOKENS=8000
# Maximum built-in web search calls per Responses request with AI budgets enabled (1–3).
AI_MAX_WEB_SEARCH_CALLS=2
AI_USER_QUEUE=10
AI_SYSTEM_QUEUE=100
# Direct reverse proxies whose client address headers may be trusted (comma-separated IPs).
TRUSTED_PROXY_ADDRESSES=
# With separate database roles, run dist/server/migrate.js using the schema owner first.
DATABASE_MIGRATE_ON_START=true
